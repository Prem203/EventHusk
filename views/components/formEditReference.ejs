<h2></h2>

<form
  action=" <%= '/references/' + ref.event_id + '/edit' %>"
  method="POST"
>
  <div>
    <label class="form-label">
      Event Name:
      <input
        class="form-control"
        type="text"
        name="event_name"
        value="<%= ref.event_name %>"
      />
    </label>
  </div>
  <div>
    <label class="form-label">
      Description:
      <input
        class="form-control"
        type="text"
        name="event_description"
        value="<%= ref.event_description %>"
      />
    </label>
  </div>

  <div>
    <label class="form-label">
      Date:
      <input
        class="form-control"
        type="date"
        name="date"
        value="<%= ref.date %>"
      />
    </label>
  </div>

  <div>
    <label class="form-label">
      Time:
      <input
        class="form-control"
        type="time"
        name="time"
        value="<%= ref.time %>"
      />
    </label>
  </div>

  <div>
    <label class="form-label">
      RSVP Deadline:
      <input
        class="form-control"
        type="datetime-local"
        name="rsvp_deadline"
        value="<%= ref.rsvp_deadline ? new Date(ref.rsvp_deadline).toISOString().slice(0, -1) : '' %>"
      />
    </label>
  </div>

  <div>
    <label class="form-label">
      UserID:
      <input
        class="form-control"
        type="text"
        name="user_id"
        value="<%= ref.user_id %>"
      />
    </label>
  </div>

  <div>
    <label class="form-label">
      Venue:
      <select class="form-control" name="venue_id" required>
        <option value="" disabled>Select a venue</option>
        <% venues.forEach(function(venue) { %>
          <option value="<%= venue.venue_id %>" <%= venue.venueID == ref.venue_id ? 'selected' : '' %>><%= venue.venue_name %></option>
        <% }); %>
      </select>
    </label>
  </div>
  

  <button type="submit" class="btn btn-primary">Edit</button>
  <a
    class="btn btn-danger"
    href="<%= '/references/' + ref.event_id + '/delete' %>"
    >Delete</a
  >
</form>
