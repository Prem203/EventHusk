<h2>Add an Event</h2>
<form action="/createReference" method="POST">
  <!-- Event Name -->
  <div class="mb-3">
    <label for="eventName" class="form-label">
      Event Name:
      <input
        id="eventName"
        class="form-control"
        type="text"
        name="event_name"
        placeholder="Enter event name"
        required
      />
    </label>
  </div>

  <!-- Description -->
  <div class="mb-3">
    <label for="eventDescription" class="form-label">
      Description:
      <textarea
        id="eventDescription"
        class="form-control"
        name="event_description"
        placeholder="Enter a short description"
        rows="3"
      ></textarea>
    </label>
  </div>

  <!-- Date -->
  <div class="mb-3">
    <label for="eventDate" class="form-label">
      Date:
      <input
        id="eventDate"
        class="form-control"
        type="date"
        name="date"
        required
      />
    </label>
  </div>

  <!-- Time -->
  <div class="mb-3">
    <label for="eventTime" class="form-label">
      Time:
      <input
        id="eventTime"
        class="form-control"
        type="time"
        name="time"
        required
      />
    </label>
  </div>

  <!-- RSVP Deadline -->
  <div class="mb-3">
    <label for="rsvpDeadline" class="form-label">
      RSVP Deadline:
      <input
        id="rsvpDeadline"
        class="form-control"
        type="datetime-local"
        name="rsvp_deadline"
      />
    </label>
  </div>

  <!-- User ID -->
  <div class="mb-3">
    <label for="userID" class="form-label">
      User ID:
      <input
        id="userID"
        class="form-control"
        type="text"
        name="user_id"
        placeholder="Enter user ID"
      />
    </label>
  </div>

  <!-- Venue Selection -->
  <div class="mb-3">
    <label for="venue" class="form-label">
      Venue:
      <select id="venue" class="form-control" name="venue_id" required>
        <option value="" disabled selected>Select a venue</option>
        <% venues.forEach(function(venue) { %>
          <option value="<%= venue.venue_id %>"><%= venue.venue_name %></option>
        <% }); %>
      </select>
    </label>
  </div>

  <!-- Submit Button -->
  <div class="mt-4">
    <button class="btn btn-primary" type="submit">Create</button>
  </div>
</form>
